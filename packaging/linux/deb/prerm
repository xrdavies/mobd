#!/bin/sh
# Removing mobd closes every user's desktops and stops their mobd, if it runs this binary.
# Upgrades keep both: desktops re-attach when the new mobd starts.
set -e
case "$1" in
remove|deconfigure) ;;
*) exit 0 ;;
esac
getent passwd | while IFS=: read -r user _ uid _ _ home _; do
  unit="$home/.config/systemd/user/mobd.service"
  [ -f "$unit" ] && grep -q '^ExecStart="\{0,1\}/usr/bin/mobd' "$unit" || continue
  runtime="/run/user/$uid"
  if [ -S "$runtime/systemd/private" ]; then
    runuser -u "$user" -- env HOME="$home" XDG_RUNTIME_DIR="$runtime" /usr/bin/mobd uninstall --yes \
      || echo "mobd: could not stop mobd for $user; run mobd uninstall as $user" >&2
  else
    echo "mobd: $user has a mobd service but no running user manager; run mobd uninstall as $user" >&2
  fi
done
exit 0
