# mobd developer-only environment example. End users should use ~/.mobd/config.json
# (see config.example.json). Copy to .env and edit, then run from the repo root:
#   set -a
#   source ./.env
#   set +a
#   make start
# mobd and Makefile do not load .env automatically.
# Priority: CLI flags > exported environment > ~/.mobd/config.json > defaults.

# Keep loopback for Tailscale Serve / SSH (docs/connection-setup.md).
# For direct LAN/VPN clients, bind to a private interface or a protected 0.0.0.0.
MOBD_LISTEN="127.0.0.1:8080"
# Live desktop WebRTC (UDP, all interfaces); 0 = a random port per session.
MOBD_STREAM_PORT=9527
MOBD_MAX_RUNNING=1
MOBD_QUESTION_TIMEOUT="30m"

# Comma-separated runners. Use "codex" to enable only Codex.
# Add ,pi to enable Pi (1.4.x or later 1.x; tested with 1.4.0).
MOBD_RUNNERS="codex,claude"
# The default agent, model lists, default model/effort and permissions are set in the
# apps (Settings → Agents) and kept in settings.json, not here.

# Executables must be on PATH, or set absolute paths here.
# $PWD expands when sourced; replace it with a fixed working directory if needed.
MOBD_CODEX_BIN="codex"
MOBD_CODEX_WORKDIR="$PWD"
MOBD_CODEX_MODE="app-server"

MOBD_CLAUDE_BIN="claude"
MOBD_CLAUDE_WORKDIR="$MOBD_CODEX_WORKDIR"
# project loads project settings; all also loads personal Claude settings.
MOBD_CLAUDE_SETTING_SOURCES="project"

# Pi uses workdir, its own installed CLI/authentication, and MOB-only MCP tools.
MOBD_PI_BIN="pi"

# Optional overrides; these are the default storage locations on macOS.
# MOBD_STATE_PATH="$HOME/Library/Application Support/mob/state.json"
# MOBD_DATA_DIR="$HOME/Library/Application Support/mob"

# Optional CORS override: replaces the entire list of allowed frontend origins.
# MOBD_CORS_ORIGINS="http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost"

# Leave these unset to use the built-in mobd mcp server.
# External MCP arguments must be a JSON array, not a comma-separated list.
# MOBD_MOB_MCP_COMMAND="/absolute/path/to/mcp-server"
# MOBD_MOB_MCP_ARGS='["--flag","value"]'

# All client routes require pairing: mobd link --url https://office.example.com
# MOBD_SHARED_SECRET is removed; unset it before upgrading.
# MOBD_CONTROL_SOCKET="$HOME/.mobd/run/control.sock"
# Comment out optional overrides instead of assigning empty values for defaults.
